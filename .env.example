# LOCAL DEVELOPMENT ONLY. Production secrets must be added with `wrangler secret put NAME`.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/study_premium_course
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-another-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET_KEY=change-this-admin-secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=

# Set after deployment, e.g. https://study-premium-course.<subdomain>.workers.dev
PUBLIC_URL=
NODE_ENV=production
